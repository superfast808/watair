NODE_ENV=production
PORT=8080

# Public/canonical URL used by SEO metadata, sitemap and schema.
BASE_URL=https://watairuk.co.uk

# Host-only Docker port used by Plesk/nginx reverse proxy.
HOST_PORT=8093
TRUST_PROXY=1

# Required before first production boot.
# Generate a unique secret, for example: openssl rand -hex 32
# The application refuses to start in production with missing/example credentials.
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP fallback/bootstrap configuration. These values are used until SMTP is
# saved under CMS -> Site settings -> Email delivery. Enquiries are still
# retained in the CMS if mail delivery is temporarily unavailable.
# CMS-stored SMTP passwords are encrypted using SESSION_SECRET.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WatAir Website <website@watairuk.co.uk>
CONTACT_TO=info@watairuk.co.uk

# Cloudflare Turnstile contact-form protection.
# Create a Managed widget in Cloudflare and allow the production/staging hostnames.
# The site key is public; the secret key must remain server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional extra server-side hostname check, e.g. watairuk.co.uk
TURNSTILE_EXPECTED_HOSTNAME=

# Optional e-commerce payment providers.
# Enable providers in CMS -> Commerce only after their server-side credentials
# are configured. Card details remain with the hosted payment provider.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal defaults to sandbox unless PAYPAL_ENV=live.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

