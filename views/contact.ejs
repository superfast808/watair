<%- include('partials/head') %><%- include('partials/header') %>
<main><section class="contact-layout"><div class="contact-intro"><p class="eyebrow">Contact WatAir</p><h1>Tell us what you need the water to do.</h1><p>Daily volume, location and intended use are enough to start. We can work through operating conditions and system size from there.</p><div class="contact-details"><a href="mailto:<%= settings.email %>"><small>Email</small><strong><%= settings.email %></strong></a><a href="tel:<%= settings.phone.replace(/\s/g,'') %>"><small>Telephone</small><strong><%= settings.phone %></strong></a></div></div><div class="contact-form-wrap"><% if(sent){ %><div class="success-box"><h2>Thanks — we have your enquiry.</h2><p>It has been logged and the WatAir team can follow up from here.</p></div><% } else { %><% if(error){ %><div class="error-box"><%= error %></div><% } %><form method="post" action="/contact" class="contact-form"><div class="two-col"><label>Name<input name="name" required maxlength="150"></label><label>Company<input name="company" maxlength="150"></label></div><div class="two-col"><label>Email<input type="email" name="email" required maxlength="254"></label><label>Phone<input name="phone" maxlength="80"></label></div><label>What are you interested in?<select name="interest"><option value="">Choose one</option><option>Home & Office</option><option>Commercial & Industrial</option><option>Leasing</option><option>Reseller opportunity</option><option>General enquiry</option></select></label><label>Tell us about the requirement<textarea name="message" required maxlength="5000" rows="7"></textarea></label><label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label><button class="button" type="submit">Send enquiry</button></form><% } %></div></section></main>
<%- include('partials/footer') %>
