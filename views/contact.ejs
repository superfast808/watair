<%- include('partials/head') %><%- include('partials/header') %>
<main id="main-content">
<%- include('partials/breadcrumbs', { items: [{ label: 'Home', href: '/' }, { label: 'Contact' }] }) %>

<section class="page-hero scenic-hero hero-has-photo contact-hero">
  <div class="page-hero-copy">
    <p class="eyebrow">Contact WatAir</p>
    <h1>Let’s talk about your water requirement.</h1>
    <p>You do not need a finished specification. Daily volume, number of people and intended use are enough to start the conversation.</p>
    <div class="hero-inline-stats">
      <span><strong>20–10,000</strong> L/day range</span>
      <span><strong>Direct</strong> project support</span>
      <a href="tel:<%= settings.phone.replace(/\s/g,'') %>">Call <%= settings.phone %> →</a>
    </div>
  </div>
  <div class="page-hero-art page-hero-photo">
    <img src="/uploads/imported/legacy/media/1027/contact-banner.jpg" alt="" aria-hidden="true" decoding="async" fetchpriority="high">
  </div>
</section>

<section class="contact-layout contact-modern contact-form-section">
  <div class="contact-intro">
    <p class="eyebrow">Useful starting points</p>
    <h2>Three things help us narrow the range quickly.</h2>
    <p>Give us what you know. We can work through the detail with you rather than expecting a complete technical brief.</p>

    <div class="contact-prompt-grid">
      <div><strong>01</strong><span>How many litres per day?</span></div>
      <div><strong>02</strong><span>How many people?</span></div>
      <div><strong>03</strong><span>What will the water be used for?</span></div>
    </div>

    <div class="contact-details">
      <a href="mailto:<%= settings.email %>"><small>Email</small><strong><%= settings.email %></strong></a>
      <a href="tel:<%= settings.phone.replace(/\s/g,'') %>"><small>Telephone</small><strong><%= settings.phone %></strong></a>
    </div>
  </div>

  <div class="contact-form-wrap">
    <% if(sent){ %>
      <div class="success-box" role="status"><p class="eyebrow">Enquiry received</p><h2>Thanks — we have your enquiry.</h2><p>It has been logged and the WatAir team can follow up from here.</p><a class="button" href="/products">Browse the range</a></div>
    <% } else { %>
      <div class="form-heading"><p class="eyebrow">Start here</p><h2>Tell us a little about the requirement.</h2><p>We’ll use this to point you toward the most relevant system or next step.</p></div>
      <% if(selectedProduct){ %><div class="selected-product"><span>Selected model</span><strong><%= selectedProduct.name %><%= selectedProduct.subtitle ? ' – ' + selectedProduct.subtitle : '' %></strong><small><%= selectedProduct.capacity_lpd.toLocaleString('en-GB') %> litres/day rated output</small></div><% } %>
      <% if(error){ %><div class="error-box" role="alert"><%= error %></div><% } %>
      <form method="post" action="/contact" class="contact-form">
        <% if(selectedProduct){ %><input type="hidden" name="product" value="<%= selectedProduct.slug %>"><% } %>
        <div class="two-col">
          <label>Name<input name="name" required maxlength="150" autocomplete="name" value="<%= formValues?.name || '' %>"></label>
          <label>Company<input name="company" maxlength="150" autocomplete="organization" value="<%= formValues?.company || '' %>"></label>
        </div>
        <div class="two-col">
          <label>Email<input type="email" name="email" required maxlength="254" autocomplete="email" inputmode="email" value="<%= formValues?.email || '' %>"></label>
          <label>Phone<input name="phone" maxlength="80" autocomplete="tel" inputmode="tel" value="<%= formValues?.phone || '' %>"></label>
        </div>
        <label>What are you interested in?
          <select name="interest">
            <option value="">Choose one</option>
            <% ['Home & Office','Commercial & Industrial','Reseller opportunity','General enquiry'].forEach(option => { const selected = formValues?.interest ? formValues.interest === option : (option === 'Home & Office' && selectedProduct?.category==='home-office') || (option === 'Commercial & Industrial' && selectedProduct?.category==='commercial-industrial'); %>
              <option value="<%= option %>" <%= selected ? 'selected' : '' %>><%= option %></option>
            <% }) %>
          </select>
        </label>
        <label>Tell us about the requirement<textarea name="message" required maxlength="5000" rows="7" placeholder="For example: location, litres per day, number of users, intended use, or the model you are considering."><%= formValues?.message || (selectedProduct ? 'I am interested in the ' + selectedProduct.name + (selectedProduct.subtitle ? ' (' + selectedProduct.subtitle + ')' : '') + '.\n\n' : '') %></textarea></label>
        <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label>
        <p class="form-privacy">We use the details you provide to respond to your enquiry. See our <a href="/privacy">privacy notice</a>.</p>
        <button class="button button-aqua" type="submit">Send enquiry</button>
      </form>
    <% } %>
  </div>
</section>
</main>
<%- include('partials/footer') %>
