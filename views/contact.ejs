<%- include('partials/head') %><%- include('partials/header') %>
<main>
<%- include('partials/breadcrumbs', { items: [{ label: 'Home', href: '/' }, { label: 'Contact' }] }) %>

<section class="contact-layout contact-modern">
  <div class="contact-intro">
    <p class="eyebrow">Contact WatAir</p>
    <h1>Let’s find the right way to make water on site.</h1>
    <p>You do not need a finished specification. Daily volume, location and intended use are enough to start the conversation.</p>

    <div class="contact-prompt-grid">
      <div><strong>01</strong><span>How many litres per day?</span></div>
      <div><strong>02</strong><span>Where will it operate?</span></div>
      <div><strong>03</strong><span>What will the water be used for?</span></div>
    </div>

    <div class="contact-details">
      <a href="mailto:<%= settings.email %>"><small>Email</small><strong><%= settings.email %></strong></a>
      <a href="tel:<%= settings.phone.replace(/\s/g,'') %>"><small>Telephone</small><strong><%= settings.phone %></strong></a>
    </div>
  </div>

  <div class="contact-form-wrap">
    <% if(sent){ %>
      <div class="success-box"><p class="eyebrow">Enquiry received</p><h2>Thanks — we have your enquiry.</h2><p>It has been logged and the WatAir team can follow up from here.</p><a class="button" href="/products">Browse the range</a></div>
    <% } else { %>
      <div class="form-heading"><p class="eyebrow">Start here</p><h2>Tell us a little about the requirement.</h2><p>We’ll use this to point you toward the most relevant system or next step.</p></div>
      <% if(error){ %><div class="error-box"><%= error %></div><% } %>
      <form method="post" action="/contact" class="contact-form">
        <div class="two-col"><label>Name<input name="name" required maxlength="150"></label><label>Company<input name="company" maxlength="150"></label></div>
        <div class="two-col"><label>Email<input type="email" name="email" required maxlength="254"></label><label>Phone<input name="phone" maxlength="80"></label></div>
        <label>What are you interested in?<select name="interest"><option value="">Choose one</option><option>Home & Office</option><option>Commercial & Industrial</option><option>Leasing</option><option>Reseller opportunity</option><option>General enquiry</option></select></label>
        <label>Tell us about the requirement<textarea name="message" required maxlength="5000" rows="7" placeholder="For example: location, litres per day, number of users, intended use, or the model you are considering."></textarea></label>
        <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label>
        <button class="button button-aqua" type="submit">Send enquiry</button>
      </form>
    <% } %>
  </div>
</section>
</main>
<%- include('partials/footer') %>
