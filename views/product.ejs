<%- include('partials/head') %><%- include('partials/header') %>
<main>
<section class="product-hero">
  <div class="product-hero-copy"><p class="eyebrow"><%= product.category === 'home-office' ? 'Home & Office' : 'Commercial & Industrial' %></p><h1><%= product.name %></h1><% if(product.subtitle){ %><p class="product-subtitle"><%= product.subtitle %></p><% } %><p><%= product.summary %></p><div class="hero-actions"><a class="button" href="/contact?product=<%= product.slug %>">Enquire about this system</a><a class="text-link" href="#specifications">See specifications ↓</a></div></div>
  <div class="product-machine">
    <% if(product.image_url){ %><img src="<%= product.image_url %>" alt="<%= product.name %>"><% } else { %><div class="machine-placeholder"><div class="machine-screen"></div><div class="machine-drop"></div><strong><%= product.capacity_lpd.toLocaleString('en-GB') %></strong><span>litres / day</span></div><% } %>
  </div>
</section>
<section class="metric-band"><div><strong><%= product.capacity_lpd.toLocaleString('en-GB') %></strong><span>Litres/day rated output</span></div><div><strong><%= product.category === 'home-office' ? 'Compact' : 'Scalable' %></strong><span><%= product.category === 'home-office' ? 'Home and workplace use' : 'Commercial and industrial use' %></span></div><div><strong>Air → Water</strong><span>Generated at point of use</span></div></section>
<section id="specifications" class="section-pad specs-section"><div><p class="eyebrow">Technical detail</p><h2>Specifications</h2><p>Performance depends on ambient temperature and relative humidity. Confirm project conditions with WatAir before specifying a system.</p></div><dl class="spec-list"><% Object.entries(product.specs).forEach(([k,v])=>{ %><div><dt><%= k %></dt><dd><%= v %></dd></div><% }) %></dl></section>
<% if(related.length){ %><section class="section-pad related"><div class="split-heading"><div><p class="eyebrow">Also consider</p><h2>Related systems</h2></div></div><div class="product-grid"><% related.forEach(p=>{ %><a class="product-card compact-card" href="/products/<%= p.slug %>"><div class="product-art"><span class="capacity"><strong><%= p.capacity_lpd.toLocaleString('en-GB') %></strong><small>L/day</small></span><div class="drop-shape"></div></div><div class="product-card-copy"><h3><%= p.name %></h3><p><%= p.summary %></p></div></a><% }) %></div></section><% } %>
</main>
<%- include('partials/footer') %>
