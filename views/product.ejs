<%- include('partials/head') %><%- include('partials/header') %>
<main>
<section class="product-hero product-hero-premium">
  <div class="product-hero-copy">
    <p class="eyebrow"><%= product.category === 'home-office' ? 'Home & Office' : 'Commercial & Industrial' %></p>
    <h1><%= product.name %></h1>
    <% if(product.subtitle){ %><p class="product-subtitle"><%= product.subtitle %></p><% } %>
    <p><%= product.summary %></p>
    <div class="product-output"><strong><%= product.capacity_lpd.toLocaleString('en-GB') %></strong><span>litres / day rated output</span></div>
    <div class="hero-actions"><a class="button button-aqua" href="/contact?product=<%= product.slug %>">Enquire about this system</a><a class="text-link text-link-light" href="#specifications">Specifications ↓</a></div>
  </div>
  <div class="product-machine">
    <% if(product.image_url){ %><img src="<%= product.image_url %>" alt="<%= product.name %>"><% } else { %><div class="machine-placeholder"><strong><%= product.capacity_lpd.toLocaleString('en-GB') %></strong><span>litres / day</span></div><% } %>
    <div class="machine-label"><span>Atmospheric Water Generator</span><strong><%= product.name %></strong></div>
  </div>
</section>

<section class="metric-band">
  <div><strong><%= product.capacity_lpd.toLocaleString('en-GB') %> L/day</strong><span>Rated water generation</span></div>
  <div><strong><%= product.category === 'home-office' ? 'Home & Office' : 'Commercial & Industrial' %></strong><span>Application class</span></div>
  <div><strong>No mains feed</strong><span>Water source: ambient air</span></div>
</section>

<section id="specifications" class="section-tight specs-section">
  <div class="spec-intro">
    <p class="eyebrow">Technical detail</p>
    <h2>Specifications</h2>
    <p>Rated production depends on ambient temperature and relative humidity. Confirm actual site conditions with WatAir before specifying a system.</p>
    <a class="text-link" href="/contact?product=<%= product.slug %>">Discuss this model →</a>
  </div>
  <dl class="spec-list"><% Object.entries(product.specs).forEach(([k,v])=>{ %><div><dt><%= k %></dt><dd><%= v %></dd></div><% }) %></dl>
</section>

<% if(related.length){ %>
<section class="section-tight related">
  <div class="split-heading"><div><p class="eyebrow">Also consider</p><h2>Related systems</h2></div></div>
  <div class="product-grid">
    <% related.forEach(p=>{ %>
    <a class="product-card image-card compact-card" href="/products/<%= p.slug %>">
      <div class="product-art">
        <% if(p.image_url){ %><img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy"><% } %>
        <span class="capacity"><strong><%= p.capacity_lpd.toLocaleString('en-GB') %></strong><small>L/day</small></span>
      </div>
      <div class="product-card-copy"><h3><%= p.name %></h3><p><%= p.summary %></p><strong>View model ↗</strong></div>
    </a>
    <% }) %>
  </div>
</section>
<% } %>

<section class="cta-panel cta-dark">
  <div><p class="eyebrow">Project sizing</p><h2>Not sure this is the right output?</h2><p>Tell us the daily demand, location, humidity and intended use. We can help narrow the range.</p></div>
  <a class="button button-aqua" href="/contact">Talk to WatAir</a>
</section>
</main>
<%- include('partials/footer') %>
