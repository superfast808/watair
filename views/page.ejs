<%- include('partials/head') %><%- include('partials/header') %>
<main>
<%
  const pageImages = {
    'how-it-works': '/uploads/imported/legacy/images/how-it-works/hydrologic-cycle.svg',
    'about': '/uploads/imported/legacy/media/1023/about-us-banner.jpg',
    'plastic-bottles': '/uploads/imported/legacy/media/1026/our-environment-banner.jpg',
    'mains-water': '/uploads/imported/legacy/media/1024/mains-water-banner.jpg',
    'resellers': '/uploads/imported/legacy/media/1027/contact-banner.jpg',
    'leasing': '/uploads/imported/legacy/media/1040/25l-1x.png'
  };
  const photoHeroSlugs = new Set(['about','plastic-bottles','mains-water','resellers']);
  const heroImage = page.hero_image || pageImages[page.slug] || settings.hero_image;
  const heroStyle = page.hero_style || (photoHeroSlugs.has(page.slug) ? 'photo' : 'graphic');
  const usePhotoHero = heroStyle === 'photo';
  const isEnvironment = page.slug === 'plastic-bottles' || page.slug === 'mains-water';
  const crumbs = [
    { label: 'Home', href: '/' },
    ...(isEnvironment ? [{ label: 'Environment', href: '/environment/plastic-bottles' }] : []),
    { label: page.title }
  ];
%>
<%- include('partials/breadcrumbs', { items: crumbs }) %>

<section class="page-hero scenic-hero page-hero-<%= page.slug %> <%= usePhotoHero ? 'hero-has-photo' : '' %>">
  <div class="page-hero-copy">
    <p class="eyebrow"><%= page.eyebrow %></p>
    <h1><%= page.hero %></h1>
    <p><%= page.intro %></p>
  </div>
  <div class="page-hero-art <%= usePhotoHero ? 'page-hero-photo' : '' %>">
    <img src="<%= heroImage %>" alt="" aria-hidden="true">
  </div>
</section>

<section class="section-tight prose-shell">
  <article class="prose"><%- page.body_html %></article>
  <aside class="page-side-card">
    <p class="eyebrow">Explore WatAir</p>
    <h3>From compact systems to industrial water generation.</h3>
    <a href="/products/home-office">Home & Office <span>→</span></a>
    <a href="/products/commercial-industrial">Commercial & Industrial <span>→</span></a>
    <a href="/faqs">FAQs <span>→</span></a>
    <a href="/contact">Talk to WatAir <span>→</span></a>
  </aside>
</section>

<section class="cta-panel cta-dark">
  <div><p class="eyebrow">Talk to WatAir</p><h2>Want to know what this looks like for your site?</h2><p>Share the daily requirement and operating environment and we can discuss the right next step.</p></div>
  <a class="button button-aqua" href="/contact">Contact us</a>
</section>
</main>
<%- include('partials/footer') %>
