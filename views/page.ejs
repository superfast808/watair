<%- include('partials/head') %><%- include('partials/header') %>
<main id="main-content">
<%
  const pageImages = {
    'how-it-works': '/uploads/imported/legacy/images/how-it-works/hydrologic-cycle.svg',
    'water-quality-maintenance': '/uploads/imported/legacy/media/1027/contact-banner.jpg',
    'about': '/uploads/imported/legacy/media/1023/about-us-banner.jpg',
    'plastic-bottles': '/uploads/imported/legacy/media/1026/our-environment-banner.jpg',
    'mains-water': '/uploads/imported/legacy/media/1024/mains-water-banner.jpg',
    'resellers': '/uploads/imported/legacy/media/1027/contact-banner.jpg',
    'leasing': '/uploads/imported/legacy/media/1040/25l-1x.png'
  };
  const photoHeroSlugs = new Set(['about','plastic-bottles','mains-water','resellers','water-quality-maintenance']);
  const heroImage = page.hero_image || pageImages[page.slug] || settings.hero_image;
  const heroStyle = page.hero_style || (photoHeroSlugs.has(page.slug) ? 'photo' : 'graphic');
  const usePhotoHero = heroStyle === 'photo';
  const isEnvironment = page.slug === 'plastic-bottles' || page.slug === 'mains-water';
  const isMaintenance = page.slug === 'water-quality-maintenance';
  const isPrivacy = page.slug === 'privacy';
  const isLegal = ['privacy','terms','refunds','cookies'].includes(page.slug);
  const crumbs = [
    { label: 'Home', href: '/' },
    ...(isEnvironment ? [{ label: 'Environment', href: '/environment/plastic-bottles' }] : []),
    ...(isMaintenance ? [{ label: 'How it works', href: '/how-it-works' }] : []),
    { label: page.title }
  ];
%>
<%- include('partials/breadcrumbs', { items: crumbs }) %>

<section class="page-hero scenic-hero page-hero-<%= page.slug %> <%= usePhotoHero ? 'hero-has-photo' : '' %>">
  <div class="page-hero-copy">
    <p class="eyebrow"><%= page.eyebrow %></p>
    <h1><%= page.hero %></h1>
    <p><%= page.intro %></p>
  </div>
  <div class="page-hero-art <%= usePhotoHero ? 'page-hero-photo' : '' %>">
    <img src="<%= heroImage %>" alt="" aria-hidden="true" decoding="async" fetchpriority="high">
  </div>
</section>

<section class="section-tight prose-shell <%= isPrivacy ? 'prose-shell-single' : '' %>">
  <article class="prose"><%- page.body_html %></article>
  <% if(isLegal && !isPrivacy){ %>
    <aside class="page-side-card">
      <p class="eyebrow">Legal & ordering</p>
      <h3>Policies for enquiries and online purchases.</h3>
      <a href="/terms">Terms of sale <span>→</span></a>
      <a href="/refunds">Refunds & returns <span>→</span></a>
      <a href="/privacy">Privacy notice <span>→</span></a>
      <a href="/cookies">Cookie notice <span>→</span></a>
      <a href="/contact">Contact WatAir <span>→</span></a>
    </aside>
  <% } else if(isMaintenance){ %>
    <aside class="page-side-card maintenance-side-card">
      <p class="eyebrow">Safe operation</p>
      <h3>Keep the system within its operating and hygiene requirements.</h3>
      <a href="/how-it-works">How AWG works <span>→</span></a>
      <a href="/faqs">AWG FAQs <span>→</span></a>
      <a href="/products">Product range <span>→</span></a>
      <a href="/contact">Ask about servicing <span>→</span></a>
    </aside>
  <% } else { %>
    <aside class="page-side-card">
      <p class="eyebrow">Explore WatAir</p>
      <h3>From compact systems to industrial water generation.</h3>
      <a href="/products/home-office">Home & Office <span>→</span></a>
      <a href="/products/commercial-industrial">Commercial & Industrial <span>→</span></a>
      <a href="/faqs">FAQs <span>→</span></a>
      <a href="/contact">Talk to WatAir <span>→</span></a>
    </aside>
  <% } %>
</section>

<% if(isPrivacy){ %>
<section class="cta-panel cta-dark">
  <div><p class="eyebrow">Privacy questions?</p><h2>Want to know more about how we handle your information?</h2><p>Contact WatAir if you have a question about personal information, privacy or your data rights.</p></div>
  <a class="button button-aqua" href="/contact">Contact WatAir</a>
</section>
<% } else if(isLegal){ %>
<section class="cta-panel cta-dark">
  <div><p class="eyebrow">Questions?</p><h2>Need to discuss an order or policy?</h2><p>Contact WatAir with the order reference where relevant and we can help with the next step.</p></div>
  <a class="button button-aqua" href="/contact">Contact WatAir</a>
</section>
<% } else if(isMaintenance){ %>
<section class="cta-panel cta-dark">
  <div><p class="eyebrow">Operation & servicing</p><h2>Unsure whether a unit is ready for drinking-water service?</h2><p>Do not guess. Check the model-specific operator manual and contact WatAir if a maintenance, sanitisation or recommissioning requirement is unclear.</p></div>
  <a class="button button-aqua" href="/contact">Contact WatAir</a>
</section>
<% } else { %>
<section class="cta-panel cta-dark">
  <div><p class="eyebrow">Talk to WatAir</p><h2>Interested? Want to know more?</h2><p>Share the daily requirement and operating environment and we can discuss the next step.</p></div>
  <a class="button button-aqua" href="/contact">Contact us</a>
</section>
<% } %>
</main>
<%- include('partials/footer') %>
