<footer class="site-footer">
  <div class="footer-lead">
    <p class="eyebrow">Water where you need it</p>
    <h2>Turn the air around you into a local water source.</h2>
    <a class="button button-light" href="/contact">Discuss your requirement</a>
  </div>
  <div class="footer-grid">
    <div>
      <a class="brand brand-footer brand-logo" href="/" aria-label="WatAir UK home"><img src="/images/logo-header.svg?v=<%= assetVersion %>" alt="WatAir – Water from Air" decoding="async"></a>
      <p><%= settings.footer_text %></p>
      <% if(settings.facebook_url || settings.instagram_url || settings.linkedin_url){ %>
      <div class="footer-socials" aria-label="WatAir social media">
        <% if(settings.facebook_url){ %><a class="footer-social" href="<%= settings.facebook_url %>" target="_blank" rel="noopener noreferrer" aria-label="WatAir on Facebook"><span class="social-mark social-facebook" aria-hidden="true">f</span><span>Facebook</span></a><% } %>
        <% if(settings.instagram_url){ %><a class="footer-social" href="<%= settings.instagram_url %>" target="_blank" rel="noopener noreferrer" aria-label="WatAir on Instagram"><span class="social-mark social-instagram" aria-hidden="true">◎</span><span>Instagram</span></a><% } %>
        <% if(settings.linkedin_url){ %><a class="footer-social" href="<%= settings.linkedin_url %>" target="_blank" rel="noopener noreferrer" aria-label="WatAir on LinkedIn"><span class="linkedin-mark" aria-hidden="true">in</span><span>LinkedIn</span></a><% } %>
      </div>
      <% } %>
    </div>
    <div>
      <h3>Products</h3>
      <a href="/products">All systems</a>
      <a href="/products/home-office">Home & Office</a>
      <a href="/products/commercial-industrial">Commercial & Industrial</a>
    </div>
    <div>
      <h3>Explore</h3>
      <a href="/how-it-works">How it works</a>
      <a href="/faqs">FAQs</a>
      <a href="/about">About WatAir</a>
      <a href="/environment/plastic-bottles">Plastic bottles</a>
      <a href="/environment/mains-water">Mains water</a>
      <a href="/resellers">Become a reseller</a>
      <a href="/privacy">Privacy notice</a>
    </div>
    <div>
      <h3>Contact</h3>
      <a href="mailto:<%= settings.email %>"><%= settings.email %></a>
      <a href="tel:<%= settings.phone.replace(/\s/g,'') %>"><%= settings.phone %></a>
      <span><%= settings.company_location %></span>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© <%= currentYear %> WatAir UK. All rights reserved.</span>
    <div><a href="/privacy">Privacy</a><span>Atmospheric Water Generation · Water from Air</span><a href="#top">Back to top ↑</a></div>
  </div>
</footer>
<script src="/js/site.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
