<div class="utility-bar">
  <div class="utility-inner">
    <div class="utility-links">
      <a class="utility-item utility-primary utility-reseller" href="/resellers">
        <span class="utility-icon" aria-hidden="true">
          <svg viewBox="0 0 20 20"><path d="M10 3.2a3 3 0 1 1 0 6 3 3 0 0 1 0-6ZM4.5 16.5c.45-3.05 2.3-4.7 5.5-4.7s5.05 1.65 5.5 4.7M15.5 5.3v3.4M13.8 7h3.4" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/></svg>
        </span>
        <span>Become a Reseller</span>
      </a>
    </div>

    <div class="utility-contact">
      <a class="utility-item" href="mailto:<%= settings.email %>">
        <span class="utility-icon" aria-hidden="true">
          <svg viewBox="0 0 20 20"><path d="M2.8 5.2h14.4v9.6H2.8V5.2Zm.6.5 6.6 5 6.6-5" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span><%= settings.email %></span>
      </a>
      <a class="utility-item" href="tel:<%= settings.phone.replace(/\s/g,'') %>">
        <span class="utility-icon" aria-hidden="true">
          <svg viewBox="0 0 20 20"><path d="M6.1 3.1 8 6.5 6.6 8c.9 2.2 2.7 4 4.9 4.9l1.5-1.4 3.4 1.9-.8 3.2c-.2.7-.9 1.2-1.7 1.1C7.7 17 3 12.3 2.3 6.1c-.1-.8.4-1.5 1.1-1.7l2.7-.7Z" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span><%= settings.phone %></span>
      </a>
      <% if(settings.facebook_url){ %>
      <a class="utility-social utility-facebook" href="<%= settings.facebook_url %>" target="_blank" rel="noopener noreferrer" aria-label="WatAir on Facebook">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.6 22v-9h3l.5-3.5h-3.5V7.3c0-1 .3-1.7 1.8-1.7h1.9V2.5c-.3 0-1.5-.1-2.8-.1-2.8 0-4.7 1.7-4.7 4.8v2.3H6.7V13h3.1v9h3.8Z"/></svg>
      </a>
      <% } %>
      <% if(settings.instagram_url){ %>
      <a class="utility-social utility-instagram" href="<%= settings.instagram_url %>" target="_blank" rel="noopener noreferrer" aria-label="WatAir on Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.4" cy="6.8" r="1.2" fill="currentColor"/></svg>
      </a>
      <% } %>
      <% if(settings.linkedin_url){ %>
      <a class="utility-social utility-linkedin" href="<%= settings.linkedin_url %>" target="_blank" rel="noopener noreferrer" aria-label="WatAir on LinkedIn">
        <span class="linkedin-mark" aria-hidden="true">in</span>
      </a>
      <% } %>
    </div>
  </div>
</div>
<header class="site-header" data-header>
  <a class="brand brand-logo" href="/" aria-label="WatAir UK home">
    <img src="/images/logo-header.svg?v=<%= assetVersion %>" alt="WatAir – Water from Air">
  </a>

  <button class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="site-nav" aria-label="Open navigation">
    <span class="menu-toggle-label">Menu</span>
    <span class="menu-toggle-icon" aria-hidden="true"><i></i><i></i></span>
  </button>

  <nav id="site-nav" class="site-nav" data-nav aria-label="Primary navigation">
    <% navigationItems.forEach(item => { %>
      <% if(item.builtin_key === 'products'){ %>
        <div class="nav-group <%= path.startsWith('/products') ? 'active' : '' %>" data-nav-group data-nav-key="products">
          <button class="nav-trigger" type="button" data-nav-trigger aria-expanded="false">
            <span class="nav-label"><%= item.label %></span> <span class="nav-chevron" aria-hidden="true"><svg viewBox="0 0 12 12" focusable="false" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </button>
          <div class="nav-dropdown nav-dropdown-products">
            <div class="nav-dropdown-intro">
              <p class="eyebrow">Product range</p>
              <h3>Water generation from 20 to 10,000 litres per day.</h3>
              <p>Choose a range, then drill into individual models, technical specifications and downloadable datasheets.</p>
              <a class="nav-feature-link" href="/products">View all systems →</a>
            </div>
            <div class="nav-menu-column">
              <span class="nav-menu-label">Home & Office</span>
              <a href="/products/home-office"><strong>View Home & Office range</strong><small>20–60 litres/day</small></a>
              <a href="/products/pw-hr-20l">PW HR-20L <small>20 L/day · Desktop / Countertop</small></a>
              <a href="/products/pw-hr-25l-low-power-consumption">PW HR-25L <small>25 L/day</small></a>
              <a href="/products/pw-hr-30l">PW HR-30L <small>30 L/day</small></a>
              <a href="/products/pw-hr-60l">PW HR-60L <small>60 L/day</small></a>
            </div>
            <div class="nav-menu-column">
              <span class="nav-menu-label">Commercial & Industrial</span>
              <a href="/products/commercial-industrial"><strong>View Commercial & Industrial</strong><small>80–10,000 litres/day</small></a>
              <a href="/products/pw-hr-80l-low-power-consumption">Compact commercial <small>80 L/day</small></a>
              <a href="/products/pw-hr-250l-low-power-consumption">Mid-range <small>250 L/day</small></a>
              <a href="/products/pw-hr-1000l-low-power-consumption">High output <small>1,000 L/day</small></a>
              <a href="/products/pw-hr-10000l-low-power-consumption">Industrial scale <small>10,000 L/day</small></a>
            </div>
          </div>
        </div>

      <% } else if(item.builtin_key === 'how-it-works'){ %>
        <div class="nav-group <%= path === '/how-it-works' || path === '/faqs' ? 'active' : '' %>" data-nav-group data-nav-key="how-it-works">
          <button class="nav-trigger" type="button" data-nav-trigger aria-expanded="false">
            <span class="nav-label"><%= item.label %></span> <span class="nav-chevron" aria-hidden="true"><svg viewBox="0 0 12 12" focusable="false" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </button>
          <div class="nav-dropdown nav-dropdown-small">
            <a href="/how-it-works"><strong>How Atmospheric Water Generation works</strong><small>Air intake, condensation, treatment and storage</small></a>
            <a href="/faqs"><strong>Frequently asked questions</strong><small>Installation, output, power, water treatment and maintenance</small></a>
            <a href="/faqs#performance-and-sizing"><strong>Choosing the right output</strong><small>Understand humidity, demand and system sizing</small></a>
          </div>
        </div>

      <% } else if(item.builtin_key === 'environment'){ %>
        <div class="nav-group <%= path.startsWith('/environment') ? 'active' : '' %>" data-nav-group data-nav-key="environment">
          <button class="nav-trigger" type="button" data-nav-trigger aria-expanded="false">
            <span class="nav-label"><%= item.label %></span> <span class="nav-chevron" aria-hidden="true"><svg viewBox="0 0 12 12" focusable="false" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </button>
          <div class="nav-dropdown nav-dropdown-small">
            <a href="/environment/plastic-bottles"><strong>Plastic bottles</strong><small>Reduce storage, delivery and single-use packaging</small></a>
            <a href="/environment/mains-water"><strong>Mains water</strong><small>Explore on-site generation as a complementary source</small></a>
          </div>
        </div>

      <% } else if(item.builtin_key === 'about'){ %>
        <div class="nav-group <%= path === '/about' || path === '/resellers' ? 'active' : '' %>" data-nav-group data-nav-key="about">
          <button class="nav-trigger" type="button" data-nav-trigger aria-expanded="false">
            <span class="nav-label"><%= item.label %></span> <span class="nav-chevron" aria-hidden="true"><svg viewBox="0 0 12 12" focusable="false" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </button>
          <div class="nav-dropdown nav-dropdown-small">
            <a href="/about"><strong>About WatAir</strong><small>Atmospheric Water Generation solutions</small></a>
            <a href="/resellers"><strong>Become a reseller</strong><small>Partner opportunities and commercial enquiries</small></a>
          </div>
        </div>

      <% } else { %>
        <a
          href="<%= item.url %>"
          class="<%= item.style === 'cta' ? 'button button-small button-aqua' : 'nav-custom-link' %>"
          data-nav-key="<%= item.builtin_key || ('custom-' + item.id) %>"
          <%= item.new_window ? 'target="_blank" rel="noopener noreferrer"' : '' %>
          <%= !item.new_window && item.url === path ? 'aria-current="page"' : '' %>
        ><%= item.label %></a>
      <% } %>
    <% }) %>
  </nav>
</header>
