<%- include('partials/head') %><%- include('partials/header') %>
<main id="main-content">
<%
  const isHomeOffice = category === 'home-office';
  const isCommercial = category === 'commercial-industrial';
  const rangeTitle = isHomeOffice ? 'Home & Office range' : isCommercial ? 'Commercial & Industrial range' : 'All WatAir systems';
  const rangeIntro = isHomeOffice
    ? 'Compact atmospheric water generators for homes, offices, hospitality and smaller workplaces.'
    : isCommercial
      ? 'Commercial and industrial atmospheric water generators from 80 to 10,000 litres per day.'
      : 'Browse the complete WatAir atmospheric water generator range.';
%>

<%- include('partials/breadcrumbs', { items: [
  { label: 'Home', href: '/' },
  { label: 'Atmospheric Water Generators', href: category === 'all' ? null : '/products' },
  ...(isHomeOffice ? [{ label: 'Home & Office' }] : isCommercial ? [{ label: 'Commercial & Industrial' }] : [])
] }) %>

<section class="page-hero scenic-hero product-list-hero">
  <div class="page-hero-copy">
    <p class="eyebrow">Atmospheric Water Generators</p>
    <h1><%= isHomeOffice ? 'Home & Office' : isCommercial ? 'Commercial & Industrial' : 'Water generation at every scale' %></h1>
    <p><%= isHomeOffice ? 'Compact systems for homes, offices and smaller workplaces — hot and cold drinking water generated from ambient air.' : isCommercial ? 'Higher-output systems for facilities, remote sites and industrial demand, from 80 to 10,000 litres per day.' : 'From compact hot-and-cold dispensers to industrial systems rated at up to 10,000 litres per day.' %></p>

    <% if(products.length){ %>
    <div class="hero-inline-stats">
      <span><strong><%= products.length %></strong> models</span>
      <span><strong><%= Math.min(...products.map(p=>p.capacity_lpd)).toLocaleString('en-GB') %>–<%= Math.max(...products.map(p=>p.capacity_lpd)).toLocaleString('en-GB') %></strong> L/day</span>
      <a href="#range">View the range ↓</a>
    </div>
    <% } %>
  </div>
  <div class="page-hero-art">
    <img src="<%= isHomeOffice ? '/uploads/imported/legacy/media/1003/pw-hr-30l.png' : isCommercial ? '/uploads/imported/legacy/media/1010/pw-hr-5000l.png' : '/uploads/imported/legacy/images/home/products.jpg' %>" alt="" aria-hidden="true">
  </div>
</section>

<section class="section-tight product-catalogue" id="range">
  <div class="catalogue-heading">
    <div>
      <p class="eyebrow">Choose a model</p>
      <h2><%= rangeTitle %></h2>
      <p><%= rangeIntro %></p>
    </div>
    <% if(products.length){ %>
      <div class="catalogue-count"><strong><%= products.length %></strong><span><%= products.length === 1 ? 'model' : 'models' %></span></div>
    <% } %>
  </div>

  <div class="filter-row">
    <a class="<%= category==='all'?'selected':'' %>" href="/products">All systems</a>
    <a class="<%= isHomeOffice?'selected':'' %>" href="/products/home-office">Home & Office</a>
    <a class="<%= isCommercial?'selected':'' %>" href="/products/commercial-industrial">Commercial & Industrial</a>
  </div>

  <% if(products.length){ %>
  <div class="product-grid catalogue-grid">
    <% products.forEach(product => { %>
    <a class="product-card image-card" href="/products/<%= product.slug %>">
      <div class="product-art">
        <% if(product.image_url){ %><img src="<%= product.image_url %>" alt="<%= product.name %>" loading="lazy"><% } %>
        <span class="capacity"><strong><%= product.capacity_lpd.toLocaleString('en-GB') %></strong><small>L/day</small></span>
      </div>
      <div class="product-card-copy">
        <span><%= product.category === 'home-office' ? 'Home & Office' : 'Commercial & Industrial' %></span>
        <h2><%= product.name %></h2>
        <% if(product.subtitle){ %><p class="subtitle"><%= product.subtitle %></p><% } %>
        <p><%= product.summary %></p>
        <div class="card-foot"><strong>Specs & datasheet</strong><b>↗</b></div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } else { %>
    <div class="catalogue-empty">
      <h3>No published products are currently assigned to this range.</h3>
      <p>Check the product category and Published switch in the CMS, or contact WatAir for help choosing a model.</p>
      <div><a class="button" href="/contact">Talk to WatAir</a><a class="text-link" href="/products">View all systems</a></div>
    </div>
  <% } %>
</section>

<section class="cta-panel cta-dark">
  <div><p class="eyebrow">Need help choosing?</p><h2>Start with litres per day and site conditions.</h2><p>Tell us the approximate demand, location and intended use and we can narrow the range quickly.</p></div>
  <a class="button button-aqua" href="/contact">Discuss your requirement</a>
</section>
</main>
<%- include('partials/footer') %>
