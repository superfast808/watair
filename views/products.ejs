<%- include('partials/head') %><%- include('partials/header') %>
<main>
<section class="page-hero product-list-hero"><p class="eyebrow">Atmospheric Water Generators</p><h1><%= category === 'home-office' ? 'Home & Office' : category === 'commercial-industrial' ? 'Commercial & Industrial' : 'Water generation at every scale' %></h1><p>From compact units to industrial systems producing up to 10,000 litres per day.</p></section>
<section class="section-pad">
  <div class="filter-row"><a class="<%= category==='all'?'selected':'' %>" href="/products">All</a><a class="<%= category==='home-office'?'selected':'' %>" href="/products/home-office">Home & Office</a><a class="<%= category==='commercial-industrial'?'selected':'' %>" href="/products/commercial-industrial">Commercial & Industrial</a></div>
  <div class="product-grid">
    <% products.forEach(product => { %>
    <a class="product-card" href="/products/<%= product.slug %>">
      <div class="product-art"><span class="capacity"><strong><%= product.capacity_lpd.toLocaleString('en-GB') %></strong><small>L/day</small></span><div class="drop-shape"></div></div>
      <div class="product-card-copy"><span><%= product.category === 'home-office' ? 'Home & Office' : 'Commercial & Industrial' %></span><h2><%= product.name %></h2><% if(product.subtitle){ %><p class="subtitle"><%= product.subtitle %></p><% } %><p><%= product.summary %></p><strong>View specifications ↗</strong></div>
    </a>
    <% }) %>
  </div>
</section>
</main>
<%- include('partials/footer') %>
