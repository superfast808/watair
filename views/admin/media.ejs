<%- include('../partials/admin-head') %>

<header class="admin-page-head">
  <div>
    <p>Images & documents</p>
    <h1>Media library</h1>
    <span class="page-help">Upload new website images or reuse the media imported from the previous WatAir site.</span>
  </div>
</header>

<% if (reqQuery?.relinked) { %>
  <div class="notice-success"><strong>Images relinked.</strong> Updated <%= reqQuery.relinked %> existing reference(s).</div>
<% } %>
<% if (reqQuery?.deleted) { %>
  <div class="notice-success"><strong>Image removed.</strong></div>
<% } %>

<section class="admin-card media-upload-card" data-library-upload-area>
  <div class="media-upload-copy">
    <p class="admin-kicker">Add new media</p>
    <h2>Upload an image</h2>
    <p>Use JPG, PNG or WebP files up to 10 MB. Once uploaded, the image becomes available in the image picker throughout the CMS.</p>
  </div>
  <label class="media-drop-zone">
    <input type="file" accept="image/jpeg,image/png,image/webp" data-library-upload hidden>
    <span class="media-drop-icon">＋</span>
    <strong>Choose an image to upload</strong>
    <small>JPG · PNG · WebP</small>
  </label>
</section>

<section class="media-status-grid">
  <div class="admin-card media-stat"><strong><%= uploads.length %></strong><span>New uploads</span></div>
  <div class="admin-card media-stat"><strong><%= summary.images %></strong><span>Imported images</span></div>
  <div class="admin-card media-stat"><strong><%= summary.documents %></strong><span>Imported documents</span></div>
  <div class="admin-card media-stat"><strong><%= ((summary.bytes + uploads.reduce((n,a)=>n+a.bytes,0)) / 1024 / 1024).toFixed(1) %> MB</strong><span>Total media</span></div>
</section>

<% if (uploads.length) { %>
<section class="admin-card media-library-section">
  <div class="card-head">
    <div><p class="admin-kicker">Uploaded through the CMS</p><h2>Your uploads</h2></div>
  </div>
  <div class="media-grid media-grid-admin">
    <% uploads.forEach(asset => { %>
      <article class="media-card">
        <a href="<%= asset.public_url %>" target="_blank" class="media-thumb"><img src="<%= asset.public_url %>" alt="" loading="lazy"></a>
        <div>
          <strong title="<%= asset.name %>"><%= asset.name %></strong>
          <small><%= (asset.bytes/1024).toFixed(1) %> KB</small>
          <div class="media-card-actions">
            <button type="button" class="text-button" data-copy-url="<%= asset.public_url %>">Copy URL</button>
            <form method="post" action="/admin/media/delete" onsubmit="return confirm('Remove this uploaded image?')">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="filename" value="<%= asset.name %>">
              <button class="text-button danger-text" type="submit">Delete</button>
            </form>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
</section>
<% } %>

<section class="admin-card legacy-import-card">
  <div class="card-head">
    <div>
      <p class="admin-kicker">Existing WatAir website</p>
      <h2>Legacy media import</h2>
      <p>Refresh the authorised import from watairuk.co.uk if new material has been added to the old website.</p>
    </div>
    <form method="post" action="/admin/media/import">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="secondary-button" type="submit" <%= importState.running ? 'disabled' : '' %>><%= importState.running ? 'Import running…' : 'Refresh imported media' %></button>
    </form>
  </div>

  <div class="media-live compact-media-status" data-media-status data-running="<%= importState.running ? '1' : '0' %>">
    <div class="import-progress">
      <div><span>Pages scanned</span><strong data-pages><%= importState.pagesScanned %></strong></div>
      <div><span>Assets found</span><strong data-found><%= importState.assetsFound %></strong></div>
      <div><span>Assets imported</span><strong data-imported><%= importState.assetsImported %></strong></div>
      <div><span>Imported</span><strong data-bytes><%= (importState.bytesImported / 1024 / 1024).toFixed(1) %> MB</strong></div>
    </div>
    <p class="import-message" data-message><%= importState.message %></p>
    <code class="import-current" data-current><%= importState.current || '' %></code>
  </div>

  <% if(summary.count){ %>
  <div class="media-action-row">
    <form method="post" action="/admin/media/relink">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="secondary-button" type="submit">Relink old image URLs locally</button>
    </form>
    <a class="text-button button-link" href="/uploads/imported/legacy/manifest.json" target="_blank">View import manifest ↗</a>
  </div>
  <% } %>
</section>

<% if (summary.images) { %>
<section class="admin-card media-library-section">
  <div class="card-head">
    <div><p class="admin-kicker">Imported library</p><h2>Existing WatAir imagery</h2></div>
    <span><%= summary.generatedAt ? formatUkDateTime(summary.generatedAt) : '' %></span>
  </div>
  <div class="media-grid media-grid-admin">
    <% summary.assets.filter(a => (a.content_type || '').startsWith('image/')).slice(0, 120).forEach(asset => { %>
      <article class="media-card">
        <a href="<%= asset.public_url %>" target="_blank" class="media-thumb"><img src="<%= asset.public_url %>" alt="" loading="lazy"></a>
        <div>
          <strong title="<%= asset.local_path %>"><%= asset.local_path.split('/').pop() %></strong>
          <small><%= (asset.bytes / 1024).toFixed(asset.bytes > 1024*1024 ? 0 : 1) %> KB · Imported</small>
          <button type="button" class="text-button" data-copy-url="<%= asset.public_url %>">Copy URL</button>
        </div>
      </article>
    <% }) %>
  </div>
  <% if(summary.images > 120){ %><p class="media-more">Showing the first 120 imported images. All imported images remain available in the CMS image picker.</p><% } %>
</section>
<% } %>

<script src="/js/admin-media.js?v=<%= assetVersion %>" defer></script>
<%- include('../partials/admin-foot') %>
