<%- include('../partials/admin-head') %>
<header class="admin-page-head"><div><p><a href="/admin/editorial">← Editorial Studio</a></p><h1><%= article?'Edit article':'New article' %></h1><span class="page-help">Publish informative, search-friendly content that your social posts can link to.</span></div><div class="admin-head-actions"><a href="/admin/editorial" class="secondary-button">Back to studio</a><% if(article&&article.status==='published'){ %><a class="admin-button" href="/news/<%= article.slug %>" target="_blank">Open live article ↗</a><% } %></div></header>
<% if(reqQuery.notice){ %><p class="ed-notice"><%= reqQuery.notice %></p><% } %><% if(reqQuery.error){ %><p class="ed-error"><%= reqQuery.error %></p><% } %>
<form class="admin-card ed-panel ed-article-editor" action="<%= article?'/admin/editorial/articles/'+article.id:'/admin/editorial/articles' %>" method="post">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="ed-two">
    <label>Headline<input name="title" value="<%= article?.title||'' %>" required minlength="8" maxlength="180"></label>
    <label>URL slug<input name="slug" value="<%= article?.slug||'' %>" placeholder="Generated from headline if blank" pattern="[a-z0-9-]*"></label>
  </div>
  <div class="ed-two">
    <label>Category<select name="category"><% ['Technology','Did you know?','Products','Applications','Water quality','Environment','Company news'].forEach(c=>{ %><option value="<%= c %>" <%= article?.category===c?'selected':'' %>><%= c %></option><% }) %></select></label>
    <label>Visibility<select name="status"><option value="draft" <%= article?.status!=='published'?'selected':'' %>>Draft (not visible to search engines)</option><option value="published" <%= article?.status==='published'?'selected':'' %>>Published (live)</option></select></label>
  </div>
  <label>Summary / introductory excerpt<textarea name="excerpt" rows="3" maxlength="600" required><%= article?.excerpt||'' %></textarea></label>
  <div class="ed-media-field" data-media-field><label>Featured image<input type="text" name="image_url" data-media-url value="<%= article?.image_url||'' %>" placeholder="/uploads/... or select from library"></label><button type="button" class="secondary-button" data-media-choose>Choose from library</button><button type="button" class="secondary-button" data-media-clear>Clear</button><div class="ed-image-preview" data-media-preview><% if(article?.image_url){ %><img src="<%= article.image_url %>" alt=""><% } %></div><span data-media-empty <%= article?.image_url?'hidden':'' %>>No image selected</span></div>
  <label>Article content (simple HTML: paragraphs, H2 headings, lists and links)<textarea name="body_html" rows="18" required class="ed-code-area"><%= article?.body_html||'' %></textarea></label>
  <div class="ed-two">
    <label>SEO title<input name="seo_title" value="<%= article?.seo_title||'' %>" maxlength="170" placeholder="Defaults to headline"></label>
    <label>Meta description<textarea name="seo_description" rows="3" maxlength="230"><%= article?.seo_description||'' %></textarea></label>
  </div>
  <div class="ed-actions"><button class="admin-button" type="submit">Save article</button><span>Changing a live article updates its public page and social link destination.</span></div>
</form>
<%- include('../partials/admin-foot') %>
