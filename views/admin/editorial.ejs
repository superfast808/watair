<%- include('../partials/admin-head') %>
<header class="admin-page-head"><div><p>Marketing & content</p><h1>Editorial Studio</h1><span class="page-help">Plan, create and distribute WatAir content to selected social channels. The website remains your canonical home.</span></div><div class="admin-head-actions"><a class="secondary-button" href="/news" target="_blank">View journal ↗</a><a class="admin-button" href="/admin/editorial/posts/new">＋ New social post</a></div></header>
<% if(reqQuery.notice){ %><p class="ed-notice"><%= reqQuery.notice %></p><% } %><% if(reqQuery.error){ %><p class="ed-error"><%= reqQuery.error %></p><% } %>
<div class="ed-metrics"><div><strong><%= totals.published %></strong><span>Live articles</span></div><div><strong><%= totals.drafts %></strong><span>Article drafts</span></div><div><strong><%= totals.queued %></strong><span>Scheduled posts</span></div><div><strong><%= totals.submitted %></strong><span>Channel submissions</span></div></div>
<section class="admin-card ed-panel ed-week-panel">
  <div class="ed-panel-head"><div><p class="admin-kicker">Publishing calendar</p><h2>The next seven days</h2></div><span class="ed-chip"><%= autoEnabled?'Autopilot '+autoTime+' UK':'Manual scheduling' %></span></div>
  <div class="ed-week">
    <% calendarDays.forEach(day=>{ %><div class="ed-day"><strong><%= day.label %></strong><small><%= day.date %></small>
      <% day.posts.forEach(post=>{ %><a class="ed-day-event" href="/admin/editorial/posts/<%= post.id %>"><%= post.headline || post.caption.slice(0,50) %><span><%= post.due_at.slice(11,16) %> UTC</span></a><% }) %>
      <% if(autoEnabled){ %><span class="ed-day-auto">✧ Automatic post · <%= autoTime %> UK</span><% } %>
      <% if(!day.posts.length&&!autoEnabled){ %><span class="ed-day-blank">No scheduled posts</span><% } %>
    </div><% }) %>
  </div>
</section>
<section class="ed-two">
  <div class="admin-card ed-panel">
    <div class="ed-panel-head"><div><p class="admin-kicker">AI writing desk</p><h2>Smart social drafts</h2></div><span class="ed-chip">GPT-5.4 mini</span></div>
    <p>Hook-first posts in rotating styles, with a short version for X/Bluesky/Threads and a branded image card. AI drafts are saved for review; your daily autopilot is controlled separately.</p>
    <form action="/admin/editorial/ai/post" method="post" class="ed-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Content angle<select name="topic"><option value="did-you-know">Did you know?</option><option value="technology">How the technology works</option><option value="product">Product spotlight</option><option value="applications">Applications</option><option value="water-quality">Water quality & maintenance</option><option value="resilience">Water resilience</option><option value="industry">Industry & commercial</option><option value="environment">Environment & responsible operation</option></select></label>
      <label>Post style<select name="angle"><option value="">Pick for me (rotates)</option><% angles.forEach(a=>{ %><option value="<%= a.id %>"><%= a.name %><%= a.productOnly?' (products)':'' %></option><% }) %></select></label>
      <label>Optional featured product<select name="product_id"><option value="">Automatically select</option><% products.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></label>
      <label>Or link to a live article<select name="article_id"><option value="">Automatically choose a relevant page</option><% articles.filter(a=>a.status==='published').forEach(a=>{ %><option value="<%= a.id %>"><%= a.title %></option><% }) %></select></label>
      <button class="admin-button" type="submit" <%= !creds.openai ? 'disabled' : '' %>>✧ Generate social draft</button>
    </form>
  </div>
  <div class="admin-card ed-panel">
    <div class="ed-panel-head"><div><p class="admin-kicker">Search-led publishing</p><h2>News & insights</h2></div><a class="secondary-button" href="/admin/editorial/articles/new">＋ Write article</a></div>
    <p>Publish educational explainers, updates, product guides and articles worth linking back to. New AI articles are always drafts until you approve them.</p>
    <form action="/admin/editorial/ai/article" method="post" class="ed-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Article subject<input name="topic" placeholder="How does an atmospheric water generator work?" required minlength="8" maxlength="220"></label>
      <label>Verified facts or points to cover<textarea name="facts" rows="3" placeholder="Optional. Give the writer specific, confirmed details to use."></textarea></label>
      <button class="admin-button" type="submit" <%= !creds.openai ? 'disabled' : '' %>>✧ Generate blog draft</button>
    </form>
  </div>
</section>
<section class="ed-two">
  <div class="admin-card ed-panel">
    <div class="ed-panel-head"><div><p class="admin-kicker">Distribution</p><h2>Connected channels</h2></div></div>
    <p>Connect the brand channels in Buffer first, then import them here and choose which should receive daily posts.</p>
    <form action="/admin/editorial/channels/sync" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="secondary-button" type="submit" <%= !creds.buffer ? 'disabled' : '' %>>↻ Sync connected Buffer channels</button></form>
    <form action="/admin/editorial/channels" method="post" class="ed-form ed-topgap">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <% if(!channels.length){ %><p class="ed-hint">No channels synced yet. Set your Buffer API key below to get started.</p><% } %>
      <% channels.forEach(c=>{ %><label class="ed-check"><input type="checkbox" name="channels" value="<%= c.id %>" <%= c.enabled ? 'checked' : '' %> <%= !c.connected ? 'disabled' : '' %>><span><strong><%= c.name %></strong><small><%= c.service %> · <%= c.connected ? 'Connected' : 'Disconnected' %></small></span></label><% }) %>
      <% if(channels.length){ %><label class="ed-check"><input data-select-all-channels type="checkbox"><span><strong>Select all connected</strong><small>Quickly select every channel for the daily publishing mix</small></span></label><button class="admin-button" type="submit">Save default destinations</button><% } %>
    </form>
  </div>
  <div class="admin-card ed-panel">
    <div class="ed-panel-head"><div><p class="admin-kicker">Daily publisher</p><h2>Autopilot</h2></div><span class="ed-chip <%= autoEnabled?'ed-chip-live':'' %>"><%= autoEnabled?'Enabled':'Off' %></span></div>
    <p>Generates a distinct factual post per day, rotates the theme and product or article destination, then submits it to your enabled channels. Runs in UK local time.</p>
    <form action="/admin/editorial/automation" method="post" class="ed-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="ed-check"><input type="checkbox" name="social_auto_enabled" value="1" <%= autoEnabled?'checked':'' %>><span><strong>Automatically publish every day</strong><small>Requires connected Buffer channels and OpenAI credit</small></span></label>
      <label>Daily posting time (Europe/London)<input type="time" name="social_auto_time" value="<%= autoTime %>" required></label>
      <label>Editorial mix<select name="social_auto_style"><option value="balanced" <%= autoStyle==='balanced'?'selected':'' %>>Balanced education & products</option><option value="educational" <%= autoStyle==='educational'?'selected':'' %>>Educational emphasis</option></select></label>
      <p class="ed-hint">AI model: <strong><%= model %></strong>. Automated content goes live without editorial approval after enabled. Configure deliberately and review early posts.</p>
      <button class="admin-button" type="submit">Save autopilot settings</button>
    </form>
  </div>
</section>
<section class="ed-two">
  <div class="admin-card ed-panel">
    <div class="ed-panel-head"><div><p class="admin-kicker">Website content</p><h2>Article library</h2></div><a href="/admin/editorial/articles/new" class="secondary-button">New article</a></div>
    <div class="ed-table"><% if(!articles.length){ %><p>No articles yet. Create one above.</p><% } %><% articles.forEach(a=>{ %><a class="ed-table-row" href="/admin/editorial/articles/<%= a.id %>"><span><strong><%= a.title %></strong><small><%= a.category %> · <%= a.status==='published'?'Live':'Draft' %></small></span><span>✎</span></a><% }) %></div>
  </div>
  <div class="admin-card ed-panel">
    <div class="ed-panel-head"><div><p class="admin-kicker">Publishing calendar</p><h2>Social queue & history</h2></div><a href="/admin/editorial/posts/new" class="secondary-button">New post</a></div>
    <div class="ed-table"><% if(!posts.length){ %><p>No posts yet. Generate your first AI draft above.</p><% } %><% posts.forEach(p=>{ %><a class="ed-table-row" href="/admin/editorial/posts/<%= p.id %>"><span><strong><%= p.headline||p.caption.slice(0,65) %></strong><small><%= p.topic %> · <%= p.status %> <%= p.due_at?' · '+p.due_at.slice(0,16)+' UTC':'' %></small></span><span>↗</span></a><% }) %></div>
  </div>
</section>
<section class="ed-two">
  <div class="admin-card ed-panel">
    <div class="ed-panel-head"><div><p class="admin-kicker">Connections</p><h2>API configuration</h2></div></div>
    <p>Keys are encrypted on the server and never returned to the browser. Leaving a field blank preserves the existing credential.</p>
    <form class="ed-form" method="post" action="/admin/editorial/credentials">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Buffer personal API key <span class="ed-status"><%= creds.buffer?'Configured':'Not configured' %></span><input name="buffer_api_key" type="password" autocomplete="new-password" placeholder="Leave blank to keep the existing key"></label>
      <label>OpenAI API key <span class="ed-status"><%= creds.openai?'Configured':'Not configured' %></span><input name="openai_api_key" type="password" autocomplete="new-password" placeholder="Leave blank to keep the existing key"></label>
      <button class="admin-button" type="submit">Save encrypted credentials</button>
    </form>
  </div>
  <div class="admin-card ed-panel">
    <div class="ed-panel-head"><div><p class="admin-kicker">Operational history</p><h2>Recent daily runs</h2></div></div>
    <div class="ed-table"><% if(!dailyRuns.length){ %><p>Automation has not run yet.</p><% } %><% dailyRuns.forEach(run=>{ %><div class="ed-table-row"><span><strong><%= run.day %> · <%= run.status %></strong><small><%= run.error || (run.post_id?'Post #'+run.post_id:'No delivery') %></small></span></div><% }) %></div>
  </div>
</section>
<%- include('../partials/admin-foot') %>
