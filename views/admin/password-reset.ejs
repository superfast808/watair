<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title><%= meta.title %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>">
</head>
<body class="admin-login">
  <main>
    <div class="login-card">
      <div class="login-brand"><img src="/images/logo-header.svg" alt="WatAir"><span>Website CMS</span></div>
      <% if(stage==='choose'){ %>
        <h1>New password</h1>
        <p>Choose a new password for <strong><%= email %></strong>. At least 14 characters, with a letter and a number.</p>
      <% } else { %>
        <h1>Reset password</h1>
        <p>Enter your admin email and we'll send you a link to set a new password.</p>
      <% } %>
      <% if(notice){ %><div class="alert alert-ok"><%= notice %></div><% } %>
      <% if(error){ %><div class="alert"><%= error %></div><% } %>
      <% if(stage==='choose'){ %>
        <form method="post" action="/admin/reset-password/<%= token %>">
          <input type="email" name="username" value="<%= email %>" autocomplete="username" hidden>
          <label>New password<input type="password" name="password" required minlength="14" autocomplete="new-password"></label>
          <label>Confirm new password<input type="password" name="confirm_password" required minlength="14" autocomplete="new-password"></label>
          <button type="submit">Save new password</button>
        </form>
      <% } else if(stage==='request'){ %>
        <form method="post" action="/admin/forgot-password">
          <label>Email<input type="email" name="email" required autocomplete="username"></label>
          <button type="submit">Send reset link</button>
        </form>
      <% } %>
      <a href="/admin/login">← Back to sign in</a>
    </div>
  </main>
</body>
</html>
