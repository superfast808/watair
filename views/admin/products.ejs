<%- include('../partials/admin-head') %><header class="admin-page-head"><div><p>Catalogue</p><h1>Products</h1></div></header><section class="admin-card"><table><thead><tr><th>Product</th><th>Category</th><th>Output</th><th>Status</th><th></th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><strong><%= p.name %></strong><br><small><%= p.subtitle %></small></td><td><%= p.category %></td><td><%= p.capacity_lpd.toLocaleString('en-GB') %> L/day</td><td><span class="pill"><%= p.published?'Published':'Draft' %></span></td><td><a class="edit-link" href="/admin/products/<%= p.id %>">Edit →</a></td></tr><% }) %></tbody></table></section><%- include('../partials/admin-foot') %>
