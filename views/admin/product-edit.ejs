<%- include('../partials/admin-head') %>

<form class="admin-form admin-editor" method="post" action="<%= isNew ? '/admin/products/new' : '/admin/products/' + product.id %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">

  <% if(!isNew && reqQuery?.delete_error){ %><div class="alert admin-alert"><strong>Product not deleted.</strong> The confirmation name did not match.</div><% } %>
<header class="admin-page-head">
    <div>
      <p><a href="/admin/products">Products</a> / <%= isNew ? 'Add product' : 'Edit product' %></p>
      <h1><%= isNew ? 'Add a product' : product.name %></h1>
      <span class="page-help"><%= isNew ? 'Start with the basics. You can leave it as a draft until it is ready.' : 'Update the product information, image and technical specifications below.' %></span>
    </div>
    <div class="admin-head-actions">
      <% if(!isNew){ %><a class="secondary-button button-link" href="/products/<%= product.slug %>" target="_blank">Preview ↗</a><% } %>
      <button class="admin-button" type="submit"><%= isNew ? 'Create product' : 'Save changes' %></button>
    </div>
  </header>

  <div class="editor-layout">
    <div class="editor-main">
      <section class="admin-card editor-section">
        <div class="section-heading">
          <span class="section-number">1</span>
          <div><h2>Product details</h2><p>The customer-facing name and short description.</p></div>
        </div>
        <div class="form-grid">
          <label class="full field-large">Product name
            <input name="name" value="<%= product.name %>" required placeholder="e.g. PW HR-100L">
            <small>Use the model name customers will recognise.</small>
          </label>
          <label>Optional subtitle
            <input name="subtitle" value="<%= product.subtitle %>" placeholder="e.g. Low Power Consumption">
          </label>
          <label>Product range
            <select name="category">
              <option value="home-office" <%= product.category==='home-office'?'selected':'' %>>Home & Office</option>
              <option value="commercial-industrial" <%= product.category==='commercial-industrial'?'selected':'' %>>Commercial & Industrial</option>
            </select>
          </label>
          <label>Rated output
            <div class="input-suffix"><input type="number" min="0" name="capacity_lpd" value="<%= product.capacity_lpd %>"><span>litres/day</span></div>
          </label>
          <label>Display order
            <input type="number" name="sort_order" value="<%= product.sort_order %>">
          </label>
          <label class="full">Short description
            <textarea name="summary" rows="4" placeholder="A concise explanation of where this model fits and who it is for."><%= product.summary %></textarea>
            <small>This appears on product cards, the product page and search metadata.</small>
          </label>
        </div>
      </section>

      <section class="admin-card editor-section">
        <div class="section-heading">
          <span class="section-number">2</span>
          <div><h2>E-commerce</h2><p>Opt this product into online sales and define how it is priced and delivered.</p></div>
        </div>
        <label class="switch-row">
          <span><strong>Sell online</strong><small>Shows a Buy now button when global e-commerce is also enabled</small></span>
          <input type="checkbox" name="sellable" <%= product.sellable?'checked':'' %>>
        </label>
        <div class="form-grid commerce-product-fields">
          <label>Customer price
            <div class="input-suffix"><input type="text" inputmode="decimal" name="price" value="<%= minorToInput(product.price_minor || 0) %>" placeholder="0.00"><span><%= settings.commerce_currency || 'GBP' %></span></div>
            <small>Enter the final customer-facing product price. Tax is not calculated separately by this build.</small>
          </label>
          <label>Maximum quantity
            <input type="number" min="1" max="25" name="max_order_qty" value="<%= product.max_order_qty || 1 %>">
            <small>Maximum units allowed in one online order.</small>
          </label>
          <label class="full">Delivery class
            <input name="delivery_class" value="<%= product.delivery_class || 'standard' %>" list="delivery-classes" placeholder="standard">
            <datalist id="delivery-classes"><option value="standard"><option value="pallet"><option value="freight"></datalist>
            <small>Delivery rules can charge different prices for standard, pallet, freight or any custom class you create.</small>
          </label>
        </div>
        <% if(settings.commerce_enabled !== '1'){ %>
          <div class="commerce-admin-note">Global e-commerce is currently off. You can prepare this product now; the Buy now button will remain hidden until Commerce is enabled.</div>
        <% } %>
      </section>

      <section class="admin-card editor-section">
        <div class="section-heading">
          <span class="section-number">3</span>
          <div><h2>Technical specifications</h2><p>No JSON required. Add each label and value as a simple row.</p></div>
        </div>

        <div class="spec-preset-bar">
          <span>Quick add:</span>
          <% ['Water Production','Storage Capacity','Working Temperature','Working Humidity','Dimensions','Net Weight','Refrigerant','Rated Power','Filtration','Certifications'].forEach(label => { %>
            <button type="button" class="mini-button" data-spec-preset="<%= label %>">+ <%= label %></button>
          <% }) %>
        </div>

        <div class="spec-editor">
          <div class="spec-editor-head"><span>Specification</span><span>Value</span><span></span></div>
          <div data-spec-list>
            <% Object.entries(product.specs || {}).forEach(([key,value]) => { %>
              <div class="spec-row" data-spec-row>
                <input name="spec_name" value="<%= key %>" placeholder="e.g. Dimensions">
                <input name="spec_value" value="<%= value %>" placeholder="e.g. 45 × 44 × 56 cm">
                <button type="button" class="icon-button danger-soft" data-remove-spec aria-label="Remove specification">×</button>
              </div>
            <% }) %>
          </div>
          <button type="button" class="secondary-button add-row-button" data-add-spec>+ Add specification</button>
        </div>

        <template data-spec-template>
          <div class="spec-row" data-spec-row>
            <input name="spec_name" placeholder="Specification name">
            <input name="spec_value" placeholder="Value">
            <button type="button" class="icon-button danger-soft" data-remove-spec aria-label="Remove specification">×</button>
          </div>
        </template>
      </section>
    </div>

    <aside class="editor-side">
      <section class="admin-card editor-section">
        <div class="section-heading compact">
          <div><h2>Product image</h2><p>Upload a new image or choose one already in the media library.</p></div>
        </div>
        <div class="media-field <%= product.image_url ? 'has-image' : '' %>" data-media-field>
          <div class="media-preview">
            <img src="<%= product.image_url || '' %>" alt="" data-media-preview <%= product.image_url ? '' : 'hidden' %>>
            <div class="media-empty" data-media-empty <%= product.image_url ? 'hidden' : '' %>>
              <strong>No image selected</strong>
              <span>JPG, PNG or WebP</span>
            </div>
          </div>
          <input type="hidden" name="image_url" value="<%= product.image_url %>" data-media-url>
          <div class="media-field-actions">
            <label class="secondary-button upload-label">Upload
              <input type="file" accept="image/jpeg,image/png,image/webp" data-media-direct-upload hidden>
            </label>
            <button class="secondary-button" type="button" data-media-choose>Choose library</button>
            <button class="text-button danger-text" type="button" data-media-clear>Remove</button>
          </div>
        </div>
      </section>

      <section class="admin-card editor-section">
        <div class="section-heading compact"><div><h2>Publishing</h2><p>Control where this product appears.</p></div></div>
        <label class="switch-row">
          <span><strong>Published</strong><small>Visible on the public website</small></span>
          <input type="checkbox" name="published" <%= product.published?'checked':'' %>>
        </label>
        <label class="switch-row">
          <span><strong>Homepage feature</strong><small>Include in featured products</small></span>
          <input type="checkbox" name="featured" <%= product.featured?'checked':'' %>>
        </label>
        <% if(!isNew){ %>
          <div class="editor-meta">
            <span>Page address</span>
            <code>/products/<%= product.slug %></code>
          </div>
        <% } %>
      </section>

      <div class="sticky-save">
        <button class="admin-button wide-button" type="submit"><%= isNew ? 'Create product' : 'Save product' %></button>
        <span>Changes are only published when you save.</span>
      </div>

      <% if(!isNew){ %>
        <section class="admin-card product-danger-zone">
          <p class="admin-kicker">Danger zone</p>
          <h2>Delete product</h2>
          <p>This permanently removes the product from the CMS and public catalogue. If you only want to hide it temporarily, switch off <strong>Published</strong> instead.</p>
          <input type="hidden" name="delete_confirmation" value="" data-delete-confirmation>
          <button
            class="danger-button wide-button"
            type="submit"
            formaction="/admin/products/<%= product.id %>/delete"
            formmethod="post"
            formnovalidate
            data-delete-product
            data-product-name="<%= product.name %>"
          >Delete product permanently</button>
          <small>The image itself is left in the media library in case it is used elsewhere.</small>
        </section>
      <% } %>
    </aside>
  </div>
</form>

<%- include('../partials/admin-foot') %>
