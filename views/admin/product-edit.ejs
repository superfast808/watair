<%- include('../partials/admin-head') %><header class="admin-page-head"><div><p>Products</p><h1>Edit <%= product.name %></h1></div><a href="/products/<%= product.slug %>" target="_blank">Preview ↗</a></header><form class="admin-form" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><section class="admin-card form-grid"><label>Name<input name="name" value="<%= product.name %>" required></label><label>Subtitle<input name="subtitle" value="<%= product.subtitle %>"></label><label>Category<select name="category"><option value="home-office" <%= product.category==='home-office'?'selected':'' %>>Home & Office</option><option value="commercial-industrial" <%= product.category==='commercial-industrial'?'selected':'' %>>Commercial & Industrial</option></select></label><label>Capacity (L/day)<input type="number" name="capacity_lpd" value="<%= product.capacity_lpd %>"></label><label class="full">Summary<textarea name="summary" rows="4"><%= product.summary %></textarea></label><label class="full">Image URL<input name="image_url" value="<%= product.image_url %>" placeholder="/uploads/example.webp"></label><label class="full">Specifications JSON<textarea class="code-area" name="specs_json" rows="16"><%= JSON.stringify(product.specs, null, 2) %></textarea></label><label>Sort order<input type="number" name="sort_order" value="<%= product.sort_order %>"></label><label class="check"><input type="checkbox" name="featured" <%= product.featured?'checked':'' %>> Feature on homepage</label><label class="check"><input type="checkbox" name="published" <%= product.published?'checked':'' %>> Published</label></section><button class="admin-button">Save product</button></form><%- include('../partials/admin-foot') %>
