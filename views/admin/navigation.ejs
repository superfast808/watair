<%- include('../partials/admin-head') %>

<header class="admin-page-head">
  <div>
    <p>Website structure</p>
    <h1>Navigation</h1>
    <span class="page-help">Rename, reorder and hide the main navigation. Add custom internal or external links without changing code.</span>
  </div>
  <a class="secondary-button button-link" href="/" target="_blank" rel="noopener">Preview website ↗</a>
</header>

<% if(reqQuery?.created){ %><div class="alert admin-alert navigation-success"><strong>Custom link added.</strong></div><% } %>
<% if(reqQuery?.saved){ %><div class="alert admin-alert navigation-success"><strong>Navigation updated.</strong></div><% } %>
<% if(reqQuery?.deleted){ %><div class="alert admin-alert navigation-success"><strong>Custom link deleted.</strong></div><% } %>

<div class="navigation-admin-layout">
  <section class="admin-card navigation-manager">
    <div class="card-head">
      <div>
        <p class="admin-kicker">Primary navigation</p>
        <h2>Menu items</h2>
        <p>The four built-in dropdowns keep their existing menu contents. Their labels, visibility and position can be changed here. Custom links and the contact button can also have their destination and style changed.</p>
      </div>
    </div>

    <div class="navigation-list">
      <% items.forEach((item,index) => { 
        const simpleItem = item.item_type === 'custom' || item.builtin_key === 'contact';
      %>
        <form class="navigation-row" method="post" action="/admin/navigation/<%= item.id %>">
          <input type="hidden" name="_csrf" value="<%= csrf %>">

          <div class="navigation-row-order">
            <span><%= index + 1 %></span>
            <div>
              <button type="submit" formaction="/admin/navigation/<%= item.id %>/move" name="direction" value="up" class="nav-order-button" aria-label="Move <%= item.label %> up" <%= index === 0 ? 'disabled' : '' %>>↑</button>
              <button type="submit" formaction="/admin/navigation/<%= item.id %>/move" name="direction" value="down" class="nav-order-button" aria-label="Move <%= item.label %> down" <%= index === items.length - 1 ? 'disabled' : '' %>>↓</button>
            </div>
          </div>

          <label class="navigation-label-field">Label
            <input name="label" maxlength="100" value="<%= item.label %>" required>
            <small><%= item.item_type === 'builtin' ? (item.builtin_key === 'contact' ? 'Built-in contact item' : 'Built-in dropdown') : 'Custom link' %></small>
          </label>

          <label class="navigation-url-field">Destination
            <% if(simpleItem){ %>
              <input name="url" maxlength="500" value="<%= item.url %>" required placeholder="/page or https://example.com">
            <% } else { %>
              <input value="Managed built-in dropdown" disabled>
            <% } %>
          </label>

          <label>Style
            <% if(simpleItem){ %>
              <select name="style">
                <option value="link" <%= item.style === 'link' ? 'selected' : '' %>>Standard link</option>
                <option value="cta" <%= item.style === 'cta' ? 'selected' : '' %>>CTA button</option>
              </select>
            <% } else { %>
              <select disabled><option>Dropdown</option></select>
            <% } %>
          </label>

          <label class="navigation-order-field">Order
            <input type="number" name="sort_order" value="<%= item.sort_order %>" min="-9999" max="99999">
          </label>

          <div class="navigation-switches">
            <label class="rule-active"><input type="checkbox" name="active" <%= item.active ? 'checked' : '' %>><span>Visible</span></label>
            <% if(simpleItem){ %><label class="rule-active"><input type="checkbox" name="new_window" <%= item.new_window ? 'checked' : '' %>><span>New tab</span></label><% } %>
          </div>

          <div class="navigation-row-actions">
            <button class="secondary-button" type="submit">Save</button>
            <% if(item.item_type === 'custom'){ %>
              <button class="danger-button" type="submit" formaction="/admin/navigation/<%= item.id %>/delete" formnovalidate data-confirm-action="Delete this custom navigation link?">Delete</button>
            <% } %>
          </div>
        </form>
      <% }) %>
    </div>
  </section>

  <aside>
    <form class="admin-card editor-section navigation-add" method="post" action="/admin/navigation/new">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="section-heading compact">
        <div><h2>Add custom link</h2><p>Add another top-level navigation item. It will initially appear at the end and can then be moved wherever you want it.</p></div>
      </div>

      <label>Link label
        <input name="label" maxlength="100" required placeholder="e.g. Case studies">
      </label>
      <label>Destination
        <input name="url" maxlength="500" required placeholder="/case-studies or https://…">
        <small>Internal paths, full HTTPS links, anchors, mailto: and tel: links are supported.</small>
      </label>
      <label>Style
        <select name="style">
          <option value="link">Standard link</option>
          <option value="cta">CTA button</option>
        </select>
      </label>
      <label class="rule-active"><input type="checkbox" name="new_window"><span>Open in a new tab</span></label>
      <button class="admin-button wide-button" type="submit">Add custom link</button>
    </form>

    <section class="admin-card navigation-guidance">
      <p class="admin-kicker">Built-in menus</p>
      <h2>Safe to reorganise</h2>
      <p>Products, How it works, Environment and About are protected because they contain structured dropdowns. Hide or rename them here rather than deleting them. Their internal dropdown links continue to follow the WatAir site structure.</p>
    </section>
  </aside>
</div>

<%- include('../partials/admin-foot') %>
