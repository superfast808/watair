<%- include('../partials/admin-head') %><header class="admin-page-head"><div><p>Pages</p><h1>Edit <%= page.title %></h1></div><a href="/<%= page.slug %>" target="_blank">Preview ↗</a></header><form class="admin-form" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><section class="admin-card form-grid"><label>Page title<input name="title" value="<%= page.title %>" required></label><label>Eyebrow<input name="eyebrow" value="<%= page.eyebrow %>"></label><label class="full">Hero heading<input name="hero" value="<%= page.hero %>" required></label><label class="full">Intro<textarea name="intro" rows="3"><%= page.intro %></textarea></label><label class="full">Body HTML<textarea class="code-area" name="body_html" rows="18"><%= page.body_html %></textarea></label><label>SEO title<input name="seo_title" value="<%= page.seo_title %>"></label><label>SEO description<textarea name="seo_description" rows="3"><%= page.seo_description %></textarea></label><label class="check"><input type="checkbox" name="published" <%= page.published?'checked':'' %>> Published</label></section><button class="admin-button">Save page</button></form><%- include('../partials/admin-foot') %>
