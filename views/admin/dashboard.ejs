<%- include('../partials/admin-head') %><header class="admin-page-head"><div><p>Overview</p><h1>Dashboard</h1></div></header><div class="stat-grid"><div><strong><%= stats.pages %></strong><span>Pages</span></div><div><strong><%= stats.products %></strong><span>Products</span></div><div><strong><%= stats.enquiries %></strong><span>New enquiries</span></div></div><section class="admin-card"><div class="card-head"><h2>Latest enquiries</h2><a href="/admin/enquiries">View all</a></div><table><thead><tr><th>Date</th><th>Name</th><th>Interest</th><th>Status</th></tr></thead><tbody><% enquiries.forEach(e=>{ %><tr><td><%= e.created_at %></td><td><strong><%= e.name %></strong><br><small><%= e.email %></small></td><td><%= e.interest || 'General' %></td><td><span class="pill"><%= e.status %></span></td></tr><% }) %></tbody></table></section><%- include('../partials/admin-foot') %>
