<%- include('../partials/admin-head') %><header class="admin-page-head"><div><p>Configuration</p><h1>Website settings</h1></div></header><form class="admin-form" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><section class="admin-card form-grid"><label>Site name<input name="site_name" value="<%= values.site_name %>"></label><label>Company location<input name="company_location" value="<%= values.company_location %>"></label><label>Email<input type="email" name="email" value="<%= values.email %>"></label><label>Phone<input name="phone" value="<%= values.phone %>"></label><label class="full">Homepage hero heading<input name="hero_title" value="<%= values.hero_title %>"></label><label class="full">Homepage hero text<textarea name="hero_text" rows="4"><%= values.hero_text %></textarea></label><label class="full">Homepage hero image URL<input name="hero_image" value="<%= values.hero_image %>"></label><label class="full">Footer text<input name="footer_text" value="<%= values.footer_text %>"></label></section><button class="admin-button">Save settings</button></form><%- include('../partials/admin-foot') %>
