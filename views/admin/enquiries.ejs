<%- include('../partials/admin-head') %><header class="admin-page-head"><div><p>Lead inbox</p><h1>Enquiries</h1></div></header><div class="enquiry-list"><% enquiries.forEach(e=>{ %><article class="admin-card enquiry"><div class="card-head"><div><span class="pill"><%= e.status %></span><h2><%= e.name %><% if(e.company){ %> · <%= e.company %><% } %></h2><p><a href="mailto:<%= e.email %>"><%= e.email %></a><% if(e.phone){ %> · <%= e.phone %><% } %></p></div><small><%= e.created_at %></small></div><p><strong>Interest:</strong> <%= e.interest || 'General' %></p><div class="message"><%= e.message %></div><% if(e.status==='new'){ %><form method="post" action="/admin/enquiries/<%= e.id %>/read"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="secondary-button">Mark read</button></form><% } %></article><% }) %></div><%- include('../partials/admin-foot') %>
